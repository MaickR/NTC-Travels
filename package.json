{
  "name": "ntc-travels",
  "version": "1.0.0",
  "description": "NTC Travels & Dreams - Sitio web de viajes de lujo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "analyze": "npx vite-bundle-visualizer",
    "scss:watch": "sass --watch scss/main.scss:css/estilos.css",
    "scss:build": "sass scss/main.scss:css/estilos.css --style=compressed",
    "lint": "eslint js/custom-*.js js/main.js",
    "lint:fix": "eslint js/custom-*.js js/main.js --fix",
    "lint:all": "eslint js/**/*.js",
    "lint:css": "stylelint scss/main.scss",
    "lint:css:fix": "stylelint scss/main.scss --fix",
    "lint:css:all": "stylelint scss/**/*.scss",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:optimize": "node scripts/optimize-images.js",
    "images:clean": "node scripts/optimize-images.js --clean",
    "build:all": "npm run scss:build && npm run images:optimize && npm run build && npm run critical:css",
    "critical:css": "node scripts/critical-css.js",
    "lighthouse": "npx lighthouse http://localhost:8000 --output html --output-path ./lighthouse-report.html --chrome-flags=\"--headless\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaickR/NTC-Travels.git"
  },
  "keywords": [
    "viajes",
    "turismo",
    "india",
    "egipto",
    "travel",
    "tours"
  ],
  "author": "NTC Development Team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MaickR/NTC-Travels/issues"
  },
  "homepage": "https://github.com/MaickR/NTC-Travels#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-terser": "^0.4.4",
    "critters": "^0.0.23",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "sass": "^1.94.2",
    "sharp": "^0.34.5",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "vite": "^7.2.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-purgecss": "^0.2.13"
  }
}
